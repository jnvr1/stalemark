{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jnvr1/stalemark/docs/schema/findings-v1.json",
  "title": "stalemark findings",
  "type": "object",
  "required": ["version", "findings"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rule", "severity", "file", "line", "column", "message", "subject", "fingerprint"],
        "additionalProperties": false,
        "properties": {
          "rule": { "type": "string", "pattern": "^SM-[A-Z][0-9]{3}$" },
          "severity": { "enum": ["error", "warning", "note"] },
          "file": { "type": "string" },
          "line": { "type": "integer", "minimum": 1 },
          "column": { "type": "integer", "minimum": 0 },
          "message": { "type": "string" },
          "subject": { "type": "string" },
          "fingerprint": { "type": "string", "pattern": "^[0-9a-f]{16}$" }
        }
      }
    }
  }
}
