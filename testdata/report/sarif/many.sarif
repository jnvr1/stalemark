          "ruleIndex": 2,
          "level": "error",
          "message": {
            "text": "poetry script \"serve\" not found in pyproject.toml"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "docs/guide.md",
                  "uriBaseId": "%SRCROOT%"
