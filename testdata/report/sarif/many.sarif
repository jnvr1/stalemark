                  "startLine": 20
                }
              }
            }
          ],
          "partialFingerprints": {
            "stalemark/v1": "73c66850323ae0b5"
          }
        },
        {
          "ruleId": "SM-A002",
          "ruleIndex": 1,
          "level": "error",
          "message": {
            "text": "make target \"bild\" not found in Makefile"
          },
          "locations": [
